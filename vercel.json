{
  "cleanUrls": true,
  "trailingSlash": false,

  "redirects": [
    {
      "source": "/ru/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ru",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.compresspdfto200kb.online"
        }
      ],
      "destination": "https://compresspdfto200kb.online/$1",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/(sitemap.xml|robots.txt|google.*\\.html)",
      "destination": "/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
