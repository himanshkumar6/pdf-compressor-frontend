{
  "redirects": [
    {
      "source": "/ru/(.*)",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es/(.*)",
      "destination": "/",
      "permanent": true
    },

    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.compresspdfto200kb.online"
        }
      ],
      "destination": "https://compresspdfto200kb.online/$1",
      "permanent": true
    },

    {
      "source": "/compress-pdf",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },

    {
      "source": "/compress-pdf-to-50kb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/compress-pdf-to-100kb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/compress-pdf-to-150kb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/compress-pdf-to-500kb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/compress-pdf-to-1mb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },

    {
      "source": "/reduce-pdf-size-to-500kb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },

    {
      "source": "/resize-pdf-200kb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/resize-pdf-kb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/resize-pdf-mb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },

    {
      "source": "/scanned-pdf-compressor",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/scanned-pdf-to-200kb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },

    {
      "source": "/merge-pdf-mac",
      "destination": "/merge-pdf",
      "permanent": true
    },
    {
      "source": "/merge-pdf-windows",
      "destination": "/merge-pdf",
      "permanent": true
    },
    {
      "source": "/merge-pdf-linux",
      "destination": "/merge-pdf",
      "permanent": true
    },

    {
      "source": "/split-pdf-mac",
