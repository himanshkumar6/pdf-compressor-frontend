{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.compresspdfto200kb.online"
        }
      ],
      "destination": "https://compresspdfto200kb.online/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ],
  "build" : {
    "env": {
       "PUPPETEER_SKIP_DOWNLOAD": "true"
     }
  }
}
