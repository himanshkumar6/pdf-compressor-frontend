      "destination": "/split-pdf",
      "permanent": true
    },
    {
      "source": "/split-pdf-adobe",
      "destination": "/split-pdf",
      "permanent": true
    },
    {
      "source": "/split-pdf-by-pages",
      "destination": "/split-pdf",
      "permanent": true
    },
    {
      "source": "/split-pdf-online",
      "destination": "/split-pdf",
      "permanent": true
    }
  ],

  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
