{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.compresspdfto200kb.online"
        }
      ],
      "destination": "https://compresspdfto200kb.online/$1",
      "permanent": true
    },

    {
      "source": "/compress-pdf",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/compress-pdf-to/:size",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/reduce-pdf-size-to-500kb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/resize-pdf-:size",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/scanned-pdf-compressor",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },
    {
      "source": "/scanned-pdf-to-200kb",
      "destination": "/compress-pdf-to-200kb",
      "permanent": true
    },

    {
      "source": "/merge-pdf-:os",
      "destination": "/merge-pdf",
      "permanent": true
    },
    {
      "source": "/split-pdf-:variant",
      "destination": "/split-pdf",
      "permanent": true
    },

    {
      "source": "/flipkart-label-cropper",
      "destination": "/pdf-to-jpg",
      "permanent": true
    },
    {
      "source": "/meesho-label-cropper",
      "destination": "/pdf-to-jpg",
      "permanent": true
    },

    {
      "source": "/ru/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/es/:path*",
      "destination": "/",
      "permanent": true
    }
  ]
}
